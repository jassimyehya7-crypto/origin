NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_. Required for pilot writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Staff auth (required — fail-closed if unset)
EC_PRO_PIN=1234
EC_FOUNDER_PIN=5678
# Optional shared secret that unlocks both roles:
# EC_STAFF_SECRET=change-me-shared

# Sms.to — confirmation réservation (code EC + lien)
SMS_TO_API_KEY=
SMS_TO_SENDER_ID=EpicerieClub
